<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>MOF_LoadingCart</defName>
		<label>loading cart</label>
		<description>A trusty wagon to carry novelties, artifacts and goods across the unforgiving lands of the rim. Traders will only take what is stored near a cart. Rotate it to pick a different wagon.</description>
		<thingClass>MedievalOverhaulFixes.Building_LoadingCart</thingClass>
		<graphicData>
			<texPath>Things/Building/Storage/Cart_Empty</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
			<damageData>
				<rect>(0.1,0.1,1.8,1.8)</rect>
			</damageData>
			<shadowData>
				<volume>(1.39,0.5,1.25)</volume>
			</shadowData>
		</graphicData>
		<modExtensions>
			<li Class="MedievalOverhaulFixes.CartVariantsExtension">
				<texPaths>
					<li>Things/Building/Storage/Cart_Empty</li>
					<li>Things/Building/Storage/Cart_WoodLog</li>
					<li>Things/Building/Storage/Cart_Ore</li>
					<li>Things/Building/Storage/Cart_Textiles</li>
				</texPaths>
			</li>
		</modExtensions>
		<rotatable>true</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<pathCost>42</pathCost>
		<blockWind>true</blockWind>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.50</fillPercent>
		<size>(2,2)</size>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>1</Flammability>
			<WorkToBuild>2000</WorkToBuild>
		</statBases>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>120</costStuffCount>
		<placeWorkers>
			<li>PlaceWorker_ShowTradeBeaconRadius</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>DankPyon_CarrierBirds</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<building>
			<claimable>false</claimable>
			<alwaysDeconstructible>true</alwaysDeconstructible>
		</building>
		<selectable>true</selectable>
		<drawerType>MapMeshAndRealTime</drawerType>
		<repairEffect>ConstructDirt</repairEffect>
		<designationCategory>Misc</designationCategory>
	</ThingDef>

</Defs>
