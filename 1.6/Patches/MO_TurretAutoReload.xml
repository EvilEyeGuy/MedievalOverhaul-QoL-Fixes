<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="DankPyon_Turret_Scorpio" or defName="DankPyon_Turret_Ballista" or defName="DankPyon_Turret_RepeaterBallista"][not(modExtensions)]</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DankPyon_Turret_Scorpio" or defName="DankPyon_Turret_Ballista" or defName="DankPyon_Turret_RepeaterBallista"][not(modExtensions)]</xpath>
			<value>
				<modExtensions />
			</value>
		</match>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="DankPyon_Turret_Scorpio" or defName="DankPyon_Turret_Ballista" or defName="DankPyon_Turret_RepeaterBallista"]/modExtensions[not(li[@Class="VEF.Weapons.AutoRefuelMannedTurrets"])]</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DankPyon_Turret_Scorpio" or defName="DankPyon_Turret_Ballista" or defName="DankPyon_Turret_RepeaterBallista"]/modExtensions[not(li[@Class="VEF.Weapons.AutoRefuelMannedTurrets"])]</xpath>
			<value>
				<li Class="VEF.Weapons.AutoRefuelMannedTurrets">
					<reloadsMoreThanSingleItem>true</reloadsMoreThanSingleItem>
				</li>
			</value>
		</match>
	</Operation>

</Patch>
