<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Medieval Overhaul: QoL &amp; Fixes</name>
  <author>Evil Eye Guy</author>
  <packageId>EEG.MedievalOverhaul.QoLFixes</packageId>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>A set of fixes and a few small additions for Medieval Overhaul.

Each patch only runs if the problem is still there. When Medieval Overhaul fixes something itself, that patch stops doing anything.

It also adds copy and paste buttons to processors and fuelled buildings, the way stockpiles have them, and lets a colonist tip over a water filled barrel to put out fires around it.

Load it after Medieval Overhaul.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
      <steamWorkshopUrl>https://steamcommunity.com/workshop/filedetails/?id=2009463077</steamWorkshopUrl>
    </li>
    <li>
      <packageId>syrchalis.processor.framework</packageId>
      <displayName>[SYR] Processor Framework</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=3210544395</steamWorkshopUrl>
    </li>
    <li>
      <packageId>DankPyon.Medieval.Overhaul</packageId>
      <displayName>Medieval Overhaul</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=3219596926</steamWorkshopUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>Ludeon.RimWorld</li>
    <li>oskarpotocki.vanillafactionsexpanded.core</li>
    <li>syrchalis.processor.framework</li>
    <li>DankPyon.Medieval.Overhaul</li>
  </loadAfter>
  <forceLoadAfter>
    <li>oskarpotocki.vanillafactionsexpanded.core</li>
    <li>DankPyon.Medieval.Overhaul</li>
  </forceLoadAfter>
</ModMetaData>
